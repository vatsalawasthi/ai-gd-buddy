# =================================================================
# AI GD Buddy — Environment Configuration
# =================================================================

# MongoDB Atlas Database Connection (Required for persistence)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_gd_buddy?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_gd_buddy
MONGODB_DB_NAME=ai_gd_buddy

# Google Gemini API Key (For AI Participant responses, Topic generation & Evaluations)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication Secret (Used to sign JWT session cookies)
AUTH_SECRET=ai_gd_buddy_super_secure_jwt_secret_key_change_in_production_2026

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional: Cloud Object Storage for Real GD Recordings (Cloudinary / S3 compatible)
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# Optional Speech-To-Text / Text-To-Speech External API (Defaults to browser Web Speech API)
SPEECH_TO_TEXT_API_KEY=
TTS_API_KEY=
